.ipynb_checkpoints/
__pycache__/
*.py[cod]
.venv/
.env
.env.*
*.log

# Keep large local datasets out of Git.
/data/*
!/data/README.md

# Regenerate notebook artifacts instead of committing them.
/notebooks/results/*
!/notebooks/results/README.md

# Small, provenance-pinned published measurements survive a fresh checkout.
!/notebooks/results/comparison/
/notebooks/results/comparison/*
!/notebooks/results/comparison/published/
